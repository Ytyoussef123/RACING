; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Street Football 5v5"
config/version="0.7.0"
run/main_scene="res://scenes/menus/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.11, 0.115, 0.135, 1)
config/icon="res://icon.svg"
config/quit_on_go_back=false

[autoload]

Config="*res://scripts/core/config.gd"
FrameRate="*res://scripts/core/frame_rate.gd"
Roster="*res://scripts/core/roster.gd"
SaveGame="*res://scripts/core/save_game.gd"
MatchSetup="*res://scripts/core/match_setup.gd"
UiTheme="*res://scripts/core/ui_theme.gd"
Screens="*res://scripts/core/screens.gd"
Settings="*res://scripts/core/settings.gd"
Sfx="*res://scripts/core/sfx.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[internationalization]

locale/translations=PackedStringArray("res://locale/strings.en.translation", "res://locale/strings.fr.translation")

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
